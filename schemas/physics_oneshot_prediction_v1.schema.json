{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics_oneshot_prediction_v1.schema.json",
  "title": "Physics zero-context one-shot prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arm_id",
    "prediction_id",
    "prompt_version",
    "execution",
    "response_file",
    "response_sha256",
    "prize_configuration",
    "rationale"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "arm_id": {"const": "physics-oneshot-gpt-6.1-sol-high-v1"},
    "prediction_id": {"pattern": "^pred-(00[1-9]|0[1-5][0-9]|060)$"},
    "prompt_version": {"const": "physics-oneshot-gpt-6.1-sol-v1"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "interface",
        "requested_model",
        "returned_model",
        "reasoning_effort",
        "request_id",
        "response_id",
        "created_at_utc",
        "usage"
      ],
      "properties": {
        "provider": {"const": "openai"},
        "interface": {"type": "string", "minLength": 1},
        "requested_model": {"const": "gpt-6.1-sol"},
        "returned_model": {
          "type": "string",
          "pattern": "^gpt-6\\.1-sol(?:-.+)?$",
          "description": "Exact model identifier returned by the execution interface; a dated snapshot suffix is allowed."
        },
        "reasoning_effort": {"const": "high"},
        "request_id": {"type": ["string", "null"], "minLength": 1},
        "response_id": {"type": ["string", "null"], "minLength": 1},
        "created_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "reasoning_tokens",
            "total_tokens"
          ],
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
            "total_tokens": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    },
    "response_file": {"const": "response.txt"},
    "response_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "prize_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "prize_parts"],
      "properties": {
        "outcome": {"enum": ["award", "no_award"]},
        "prize_parts": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["credited_names", "description"],
            "properties": {
              "credited_names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "description": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    },
    "rationale": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "A concise transcription of rationale present in the verbatim response, or null when none was returned."
    }
  }
}
